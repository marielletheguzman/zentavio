{
  // Root config. Exists so the TypeScript-aware import resolver in eslint.config.mjs has a
  // project to read, and so `tsc --noEmit` covers the packages.
  //
  // `allowJs` with `checkJs: false` keeps the project non-empty (tsc errors TS18003 on a config
  // with no inputs) without type-checking the .mjs scripts.
  //
  // ADR-0007 follow-up: convert this to project references once there are enough workspaces to
  // benefit, so each package builds independently. Tracked separately.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts", "tools/**/*.mjs", "packages/**/*.ts", "*.ts", "*.mts", "*.mjs"],
  "exclude": ["node_modules", "dist", "**/.next", "ai", ".claude"]
}
