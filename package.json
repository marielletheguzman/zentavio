{
  "name": "zentavio",
  "private": true,
  "description": "AI career intelligence platform. Not a job board.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "boundaries:audit": "node tools/scripts/audit-boundary-disables.mjs",
    "check:prompt-versions": "python ai/shared/evals/check_prompt_versions.py",
    "eval": "python ai/shared/evals/run_evals.py",
    "eval:offline": "python ai/shared/evals/run_evals.py --offline",
    "lint": "eslint .",
    "lint:all": "eslint . && tsc --noEmit && vitest run --project unit && ruff check ai/ && python -m pytest && node tools/scripts/audit-boundary-disables.mjs",
    "lint:fix": "eslint . --fix",
    "lint:py": "ruff check ai/",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:py": "python -m pytest",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.15.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import-x": "^4.4.2",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.10"
  }
}
