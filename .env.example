# Zentavio configuration — every key, with a placeholder value.
#
# This file is the discoverable inventory of what configuration exists. A key that exists in
# code but not here is a documentation bug (docs/development/environment.md).
#
#   cp .env.example .env    then fill in local values
#
# Read only through packages/config. process.env anywhere else fails the build (ADR-0005).
# Never put a real secret in this file.

# ── Prompt evals (ADR-0009) ──────────────────────────────────────────────────
# Both are optional; the defaults below are what packages/config applies.
# The Python eval runner duplicates these defaults — parity is checked by
# ai/shared/evals/tests/test_config_parity.py.
OLLAMA_HOST=http://127.0.0.1:11434
ZENTAVIO_EVAL_MODEL=qwen2.5:7b-instruct

# Keys for PostgreSQL, Redis, Qdrant, connectors, and billing are deliberately absent:
# nothing reads them yet, and declaring one before it is read means the first reader inherits
# an untested default. Add a key here in the same change that adds it to packages/config.
