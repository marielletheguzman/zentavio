# Zentavio configuration — every key, with a placeholder value.
#
# This file is the discoverable inventory of what configuration exists. A key that exists in
# code but not here is a documentation bug (docs/development/environment.md).
#
#   cp .env.example .env    then fill in local values
#
# Read only through packages/config. process.env anywhere else fails the build (ADR-0005).
# Never put a real secret in this file.
#
# **Enforced, not trusted.** `packages/config/src/env-example.test.ts` asserts this file lists
# exactly the keys `zentavioSchema` declares. It drifted for four merged changes before that test
# existed, and the symptom was someone unable to start the stack from the documentation.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── PostgreSQL (ADR-0012) ────────────────────────────────────────────────────
# ZENTAVIO_DATABASE_URL has NO default and is REQUIRED once anything connects: a
# plausible-but-wrong default is how migrations get applied to the wrong database.
ZENTAVIO_DATABASE_URL=postgresql://zentavio:password@localhost:5432/zentavio
ZENTAVIO_DATABASE_MAX_CONNECTIONS=10
ZENTAVIO_DATABASE_CONNECTION_TIMEOUT_MS=5000

# ── Services the gateway calls (ADR-0003) ────────────────────────────────────
# Neither has a default, for the same reason as the database url: a gap computed by something
# other than the service you meant is indistinguishable from a correct one.
ZENTAVIO_RESUME_PARSER_URL=http://127.0.0.1:8001
ZENTAVIO_SKILL_GAP_URL=http://127.0.0.1:8002

# ── Browsers allowed to call the gateway ─────────────────────────────────────
# **Unset means no CORS headers at all, so apps/web cannot reach the API** — deny by default, the
# same posture as authentication. The gateway warns at boot when this is empty, because the
# symptom in the browser is "Could not reach the server", which points at the wrong thing.
# Never `*`: this API is authenticated, and a wildcard origin lets any page a user visits act as
# them.
ZENTAVIO_WEB_ORIGIN=http://127.0.0.1:3000

# ── Authentication (ADR-0017) ────────────────────────────────────────────────
# Both empty means the gateway denies every request — a locked door, not an open one. Any OIDC
# provider is these two values; verification is standard JWKS, so there is no code change.
ZENTAVIO_OIDC_ISSUER=
ZENTAVIO_OIDC_AUDIENCE=
# The development credential: an `x-zentavio-dev-user` header naming a user id. Refused outright
# in production, and real authentication wins whenever it is configured, so leaving this on cannot
# downgrade a properly-configured environment.
ZENTAVIO_INSECURE_DEV_AUTH=true

# ── The résumé parser's model-backed steps (ADR-0018) ────────────────────────
# `off` is a supported configuration, not a broken one: the parser still produces a complete
# deterministic profile and reports `enrichment: "unavailable"`, which means the profile had no
# injection screening. Pull the model first: `ollama pull qwen2.5:14b-instruct` (~9 GB).
ZENTAVIO_PARSER_MODEL=qwen2.5:14b-instruct
ZENTAVIO_PARSER_ENRICHMENT=on

# ── Prompt evals (ADR-0009) ──────────────────────────────────────────────────
# Separate from ZENTAVIO_PARSER_MODEL even though the value matches today: the eval pin exists so
# delta reports compare like with like and moves only with a recorded baseline, while the parser
# model is what serves traffic. The Python eval runner duplicates these defaults — parity is
# checked by ai/shared/evals/tests/test_config_parity.py.
OLLAMA_HOST=http://127.0.0.1:11434
ZENTAVIO_EVAL_MODEL=qwen2.5:14b-instruct

# Keys for Redis, Qdrant, connectors, and billing are deliberately absent: nothing reads them
# yet, and declaring one before it is read means the first reader inherits an untested default.
# Add a key here in the same change that adds it to packages/config — the test above will fail
# if you forget.

# Base URL of the career-roadmap (eligibility) service, e.g. http://127.0.0.1:8003
ZENTAVIO_CAREER_ROADMAP_URL=

# Object storage for archived source documents (ADR-0021). MinIO locally, Cloudflare R2 in production.
ZENTAVIO_STORAGE_ENDPOINT=http://127.0.0.1:9000
ZENTAVIO_STORAGE_REGION=auto
ZENTAVIO_STORAGE_BUCKET=zentavio-documents
ZENTAVIO_STORAGE_ACCESS_KEY_ID=
ZENTAVIO_STORAGE_SECRET_ACCESS_KEY=
ZENTAVIO_STORAGE_PROVIDER=minio

ZENTAVIO_LEVER_BOARDS=
ZENTAVIO_LEVER_API_BASE=https://api.lever.co

# Lever boards to read. Zoox: 239 real postings, embedded/systems roles.
ZENTAVIO_LEVER_BOARDS=zoox
